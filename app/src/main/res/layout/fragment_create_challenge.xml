<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 41 Tạo thử thách — Thành viên B.
    B tự viết: adapter rvExercises (item_challenge_exercise, 9 bài), nút −/+ đổi tvTarget, chọn thời gian,
    lưu thử thách vào danh sách mẫu. "Tiếp tục – Mời bạn bè" → 42 đã nối sẵn.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/exercise_bottom_bar_space">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_20"
                android:paddingEnd="@dimen/space_20">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.AICoach.Auth.BackButton" />

                <TextView
                    style="@style/Widget.AICoach.B.ToolbarTitle"
                    android:text="@string/social_create_title" />
            </LinearLayout>

            <!-- Chọn bài tập -->
            <TextView
                style="@style/Widget.AICoach.Survey.Section"
                android:layout_marginStart="@dimen/space_20"
                android:text="@string/social_pick_exercise" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_20"
                android:paddingEnd="@dimen/space_20"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_challenge_exercise" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_20"
                android:paddingEnd="@dimen/space_20">

                <!-- Mục tiêu mỗi ngày -->
                <TextView
                    style="@style/Widget.AICoach.Survey.Section"
                    android:text="@string/social_daily_target" />

                <LinearLayout
                    style="@style/Widget.AICoach.B.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMinus"
                        style="@style/Widget.AICoach.CircleIconButton"
                        android:backgroundTint="@color/bg_screen"
                        android:contentDescription="@string/social_decrease"
                        android:src="@drawable/ic_remove_24"
                        app:tint="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTarget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/b_target_value_size"
                            android:textStyle="bold"
                            tools:text="100" />

                        <TextView
                            android:id="@+id/tvTargetUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.AICoach.Caption"
                            tools:text="lần squat / ngày" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnPlus"
                        style="@style/Widget.AICoach.CircleIconButton"
                        android:background="@drawable/bg_auth_gradient_circle_ripple"
                        android:contentDescription="@string/social_increase"
                        android:src="@drawable/ic_add_24"
                        app:tint="@color/white" />
                </LinearLayout>

                <!-- Thời gian thử thách -->
                <TextView
                    style="@style/Widget.AICoach.Survey.Section"
                    android:text="@string/social_duration" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_survey_segment"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDays3"
                        style="@style/Widget.AICoach.Segment"
                        android:text="@string/social_duration_3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDays7"
                        style="@style/Widget.AICoach.Segment"
                        android:checked="true"
                        android:text="@string/social_duration_7" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDays14"
                        style="@style/Widget.AICoach.Segment"
                        android:text="@string/social_duration_14" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDays30"
                        style="@style/Widget.AICoach.Segment"
                        android:text="@string/social_duration_30" />
                </LinearLayout>

                <!-- Tên thử thách -->
                <TextView
                    style="@style/Widget.AICoach.Auth.Label"
                    android:layout_marginTop="@dimen/space_20"
                    android:labelFor="@id/etName"
                    android:text="@string/social_challenge_name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilName"
                    style="@style/Widget.AICoach.Auth.TextInput"
                    android:layout_marginTop="@dimen/space_8"
                    app:endIconDrawable="@drawable/ic_edit_24"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        style="@style/Widget.AICoach.Auth.EditText"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLength="40"
                        tools:text="100 Squat mỗi ngày" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Chỉ người được mời -->
                <LinearLayout
                    style="@style/Widget.AICoach.B.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <ImageView
                        style="@style/Widget.AICoach.B.SettingIcon"
                        android:layout_width="@dimen/icon_circle_size"
                        android:layout_height="@dimen/icon_circle_size"
                        android:src="@drawable/ic_lock_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/social_private"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/social_private_desc"
                            android:textAppearance="@style/TextAppearance.AICoach.Caption" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPrivate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:contentDescription="@string/social_private" />
                </LinearLayout>

                <!-- Phần thưởng huy hiệu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_auth_info_box"
                    android:backgroundTint="@color/gold_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <FrameLayout
                        android:layout_width="@dimen/b_avatar_small"
                        android:layout_height="@dimen/b_avatar_small"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/state_warning">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_medal_24"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvReward"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="Người hoàn thành nhận huy hiệu “Chiến binh Squat”" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_exercise_bottom_fade"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/social_continue_invite"
            app:icon="@drawable/ic_group_24"
            app:iconSize="@dimen/icon_size_small" />
    </FrameLayout>
</FrameLayout>
