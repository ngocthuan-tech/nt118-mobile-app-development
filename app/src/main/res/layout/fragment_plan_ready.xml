<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 17 Giáo án đã sẵn sàng (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_16">

        <!-- Header xanh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/space_20"
            android:paddingBottom="@dimen/space_24">

            <TextView
                style="@style/Widget.AICoach.ChipDark"
                android:background="@drawable/bg_glass_card"
                android:drawableStart="@drawable/ic_sparkle_24"
                android:drawableTint="@color/accent_cyan"
                android:text="@string/plan_ready_badge"
                android:textStyle="normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/plan_ready_title"
                android:textAppearance="@style/TextAppearance.AICoach.OnDark.Title" />

            <TextView
                android:id="@+id/tvPlanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Đốt mỡ toàn thân – 4 tuần" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.AICoach.Plan.Stat">

                    <TextView
                        android:id="@+id/tvWeeks"
                        style="@style/Widget.AICoach.Plan.StatValue"
                        tools:text="4" />

                    <TextView
                        style="@style/Widget.AICoach.MiniStat.Label"
                        android:text="@string/plan_stat_weeks" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/space_8"
                    android:layout_height="0dp" />

                <LinearLayout style="@style/Widget.AICoach.Plan.Stat">

                    <TextView
                        android:id="@+id/tvSessions"
                        style="@style/Widget.AICoach.Plan.StatValue"
                        tools:text="12" />

                    <TextView
                        style="@style/Widget.AICoach.MiniStat.Label"
                        android:text="@string/plan_stat_sessions" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/space_8"
                    android:layout_height="0dp" />

                <LinearLayout style="@style/Widget.AICoach.Plan.Stat">

                    <TextView
                        android:id="@+id/tvMinutes"
                        style="@style/Widget.AICoach.Plan.StatValue"
                        tools:text="25′" />

                    <TextView
                        style="@style/Widget.AICoach.MiniStat.Label"
                        android:text="@string/plan_stat_minutes" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tuần 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_20"
            android:paddingEnd="@dimen/space_12">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/plan_week_intro"
                android:textAppearance="@style/TextAppearance.AICoach.SectionTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeeAll"
                style="@style/Widget.AICoach.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                tools:text="Xem đủ 4 tuần" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:nestedScrollingEnabled="false"
            android:paddingStart="@dimen/space_20"
            android:paddingEnd="@dimen/space_20"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_plan_session" />

        <include
            android:id="@+id/aiNote"
            layout="@layout/view_ai_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_20"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginEnd="@dimen/space_20" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_24" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_20"
            android:paddingEnd="@dimen/space_20">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/plan_ready_start" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="10dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/brand_primary"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdjust"
            style="@style/Widget.AICoach.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/plan_ready_adjust"
            android:textColor="@color/brand_primary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
