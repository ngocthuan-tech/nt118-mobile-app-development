<?xml version="1.0" encoding="utf-8"?>
<!-- 1 dòng "Phân tích từ AI" (Figma 13): vạch màu + icon + tiêu đề + mô tả -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_button"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewAccent"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/state_warning" />

        <FrameLayout
            android:id="@+id/iconBg"
            android:layout_width="@dimen/icon_circle_size"
            android:layout_height="@dimen/icon_circle_size"
            android:layout_marginStart="@dimen/space_12"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/state_warning_light">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alert_24"
                app:tint="@color/state_warning" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_12">

            <TextView
                android:id="@+id/tvFeedbackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.AICoach.SectionTitle"
                tools:text="Gối hơi chụm vào trong" />

            <TextView
                android:id="@+id/tvFeedbackDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.AICoach.Caption"
                tools:text="Xuất hiện 4 lần • chủ yếu ở hiệp 3" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
