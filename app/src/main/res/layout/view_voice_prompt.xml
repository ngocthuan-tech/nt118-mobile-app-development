<?xml version="1.0" encoding="utf-8"?>
<!--
    Thẻ "Đang nhắc bằng giọng nói" (Figma 29, 30, 31). Màu đổi theo ngữ cảnh bằng code:
    xanh cyan (đếm ngược), vàng (nhắc thường), đỏ (sai tư thế).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVoice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_12">

    <FrameLayout
        android:id="@+id/voiceIconBg"
        android:layout_width="@dimen/icon_circle_size"
        android:layout_height="@dimen/icon_circle_size"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/state_warning">

        <ImageView
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_volume_24"
            app:tint="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVoiceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workout_voice_label"
            android:textColor="@color/state_warning"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvVoicePrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="“Hạ hông thấp hơn một chút”" />
    </LinearLayout>

    <!-- Sóng âm trang trí -->
    <LinearLayout
        android:id="@+id/voiceWave"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View style="@style/Widget.AICoach.VoiceBar" android:layout_height="8dp" />
        <View style="@style/Widget.AICoach.VoiceBar" android:layout_height="14dp" />
        <View style="@style/Widget.AICoach.VoiceBar" android:layout_height="20dp" />
        <View style="@style/Widget.AICoach.VoiceBar" android:layout_height="12dp" />
        <View style="@style/Widget.AICoach.VoiceBar" android:layout_height="6dp" />
    </LinearLayout>
</LinearLayout>
