<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 15 Khảo sát 3/3 – Trình độ & lịch tập (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <include
            android:id="@+id/header"
            layout="@layout/view_survey_header" />

        <TextView
            style="@style/Widget.AICoach.Auth.Title"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/survey_schedule_title" />

        <TextView
            style="@style/Widget.AICoach.Auth.Subtitle"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/survey_schedule_subtitle" />

        <!-- Trình độ -->
        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:text="@string/survey_level" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <include
                android:id="@+id/levelBeginner"
                layout="@layout/view_survey_level" />

            <Space
                android:layout_width="@dimen/space_8"
                android:layout_height="0dp" />

            <include
                android:id="@+id/levelIntermediate"
                layout="@layout/view_survey_level" />

            <Space
                android:layout_width="@dimen/space_8"
                android:layout_height="0dp" />

            <include
                android:id="@+id/levelAdvanced"
                layout="@layout/view_survey_level" />
        </LinearLayout>

        <!-- Ngày tập trong tuần -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.AICoach.Survey.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/survey_days" />

            <TextView
                android:id="@+id/tvDaysCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="3 buổi/tuần" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <TextView android:id="@+id/dayMon" style="@style/Widget.AICoach.Survey.Day" android:text="@string/day_mon" />
            <TextView android:id="@+id/dayTue" style="@style/Widget.AICoach.Survey.Day" android:text="@string/day_tue" />
            <TextView android:id="@+id/dayWed" style="@style/Widget.AICoach.Survey.Day" android:text="@string/day_wed" />
            <TextView android:id="@+id/dayThu" style="@style/Widget.AICoach.Survey.Day" android:text="@string/day_thu" />
            <TextView android:id="@+id/dayFri" style="@style/Widget.AICoach.Survey.Day" android:text="@string/day_fri" />
            <TextView android:id="@+id/daySat" style="@style/Widget.AICoach.Survey.Day" android:text="@string/day_sat" />
            <TextView android:id="@+id/daySun" style="@style/Widget.AICoach.Survey.Day" android:text="@string/day_sun" />
        </LinearLayout>

        <!-- Thời lượng mỗi buổi -->
        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:text="@string/survey_duration" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_survey_segment"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDuration15"
                style="@style/Widget.AICoach.Segment"
                tools:text="15 phút" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDuration25"
                style="@style/Widget.AICoach.Segment"
                tools:text="25 phút" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDuration40"
                style="@style/Widget.AICoach.Segment"
                tools:text="40 phút" />
        </LinearLayout>

        <!-- Giờ nhắc tập -->
        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:text="@string/survey_reminder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_survey_option"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <FrameLayout
                android:layout_width="@dimen/survey_option_icon_box"
                android:layout_height="@dimen/survey_option_icon_box"
                android:background="@drawable/bg_icon_box"
                android:backgroundTint="@color/brand_primary_light">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bell_24"
                    app:tint="@color/brand_primary" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/rowReminderTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReminderTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/survey_big_value_size"
                    android:textStyle="bold"
                    tools:text="19:00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_reminder_desc"
                    android:textAppearance="@style/TextAppearance.AICoach.Caption" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/survey_reminder" />
        </LinearLayout>

        <!-- Dự kiến mỗi tuần -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:background="@drawable/bg_survey_estimate"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/survey_estimate"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.AICoach.Survey.Estimate">

                    <TextView
                        android:id="@+id/tvEstSessions"
                        style="@style/Widget.AICoach.Survey.EstimateValue"
                        tools:text="3" />

                    <TextView
                        style="@style/Widget.AICoach.MiniStat.Label"
                        android:text="@string/survey_estimate_sessions" />
                </LinearLayout>

                <LinearLayout style="@style/Widget.AICoach.Survey.Estimate">

                    <TextView
                        android:id="@+id/tvEstMinutes"
                        style="@style/Widget.AICoach.Survey.EstimateValue"
                        tools:text="75" />

                    <TextView
                        style="@style/Widget.AICoach.MiniStat.Label"
                        android:text="@string/survey_estimate_minutes" />
                </LinearLayout>

                <LinearLayout style="@style/Widget.AICoach.Survey.Estimate">

                    <TextView
                        android:id="@+id/tvEstKcal"
                        style="@style/Widget.AICoach.Survey.EstimateValue"
                        tools:text="~900" />

                    <TextView
                        style="@style/Widget.AICoach.MiniStat.Label"
                        android:text="@string/survey_estimate_kcal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_24" />

        <include
            android:id="@+id/footer"
            layout="@layout/view_survey_footer" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
