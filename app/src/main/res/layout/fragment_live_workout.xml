<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 30 "Tập với AI Camera" + 31 "Phát hiện sai tư thế" (Trưởng nhóm).
    Lớp dưới: PreviewView (CameraX) + PoseOverlayView (khung xương ML Kit).
    Lớp giữa: số rep, điểm tư thế, phản hồi từng rep, nhắc giọng nói, nút điều khiển.
    Lớp trên cùng (ẩn sẵn): Tạm dừng (Figma 33) và Xác nhận kết thúc (Figma 34).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <com.aicoach.pose.PoseOverlayView
        android:id="@+id/poseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/workout_scrim_height"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/workout_scrim_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom" />

    <!-- Viền đỏ khi sai tư thế (Figma 31) -->
    <View
        android:id="@+id/viewErrorVignette"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_error_vignette"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/space_20">

        <!-- ===== Hàng trên: Thoát • Bài/Hiệp • Đồng hồ ===== -->
        <ImageButton
            android:id="@+id/btnClose"
            style="@style/Widget.AICoach.CircleIconButton"
            android:backgroundTint="@color/white_10"
            android:contentDescription="@string/workout_exit"
            android:src="@drawable/ic_close_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/chipExerciseSet"
            style="@style/Widget.AICoach.ChipDark"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@id/btnClose"
            app:layout_constraintEnd_toStartOf="@id/chipTimer"
            app:layout_constraintTop_toTopOf="@id/btnClose"
            tools:text="Squat • Hiệp 2/3" />

        <LinearLayout
            android:id="@+id/chipTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@id/btnClose"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnClose">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/state_error" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="02:14" />
        </LinearLayout>

        <!-- ===== Bộ đếm rep lớn ===== -->
        <TextView
            android:id="@+id/tvRepCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="120sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnClose"
            tools:text="12" />

        <TextView
            android:id="@+id/tvRepTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvRepUnit"
            app:layout_constraintStart_toEndOf="@id/tvRepCount"
            tools:text="/ 15" />

        <TextView
            android:id="@+id/tvRepUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:text="@string/workout_rep_unit"
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/tvRepCount"
            app:layout_constraintStart_toStartOf="@id/tvRepTarget" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressReps"
            android:layout_width="@dimen/workout_rep_progress_width"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/accent_cyan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRepCount"
            app:trackColor="@color/white_20"
            app:trackCornerRadius="3dp"
            app:trackThickness="5dp"
            tools:progress="80" />

        <!-- Lần vừa rồi không được tính (Figma 31) -->
        <TextView
            android:id="@+id/chipNotCounted"
            style="@style/Widget.AICoach.ChipDark"
            android:layout_marginTop="@dimen/space_8"
            android:backgroundTint="@color/state_error"
            android:drawableStart="@drawable/ic_close_24"
            android:text="@string/workout_rep_not_counted"
            android:textSize="12sp"
            android:visibility="gone"
            app:drawableTint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressReps"
            tools:visibility="visible" />

        <!-- Điểm tư thế hiện tại -->
        <LinearLayout
            android:id="@+id/chipPostureScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_chip_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipTimer">

            <View
                android:id="@+id/dotPosture"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/state_success" />

            <TextView
                android:id="@+id/tvPostureScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:textColor="@color/state_success"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Tư thế 92%" />
        </LinearLayout>

        <!-- Góc khớp đang đo (về sau đặt đúng cạnh khớp gối) -->
        <TextView
            android:id="@+id/chipJointAngle"
            style="@style/Widget.AICoach.ChipDark"
            android:backgroundTint="@color/state_success"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            tools:text="Góc gối 94°" />

        <!-- ===== Phản hồi từng rep: xanh = đúng, đỏ = sai ===== -->
        <TextView
            android:id="@+id/chipRepFeedback"
            style="@style/Widget.AICoach.ChipDark"
            android:layout_marginBottom="@dimen/space_16"
            android:backgroundTint="@color/state_success"
            android:drawableStart="@drawable/ic_check_24"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_12"
            android:textSize="14sp"
            app:drawableTint="@color/white"
            app:layout_constraintBottom_toTopOf="@id/voicePrompt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Lần 12 – Đúng tư thế" />

        <include
            android:id="@+id/voicePrompt"
            layout="@layout/view_voice_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20"
            app:layout_constraintBottom_toTopOf="@id/btnPause"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ===== Hàng nút điều khiển ===== -->
        <ImageButton
            android:id="@+id/btnSound"
            android:layout_width="@dimen/workout_control_size"
            android:layout_height="@dimen/workout_control_size"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/white_10"
            android:contentDescription="@string/workout_sound"
            android:src="@drawable/ic_volume_24"
            app:layout_constraintBottom_toBottomOf="@id/btnPause"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnPause"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="@dimen/workout_pause_size"
            android:layout_height="@dimen/workout_pause_size"
            android:background="@drawable/bg_circle"
            android:contentDescription="@string/workout_pause"
            android:elevation="6dp"
            android:src="@drawable/ic_pause_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/navy_900" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            style="@style/Widget.AICoach.Button.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workout_finish"
            app:layout_constraintBottom_toBottomOf="@id/btnPause"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnPause" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Lớp phủ Tạm dừng (Figma 33) -->
    <include
        android:id="@+id/pauseOverlay"
        layout="@layout/view_pause_overlay"
        android:visibility="gone" />

    <!-- Lớp phủ Xác nhận kết thúc (Figma 34) -->
    <include
        android:id="@+id/finishConfirm"
        layout="@layout/view_finish_confirm"
        android:visibility="gone" />
</FrameLayout>
