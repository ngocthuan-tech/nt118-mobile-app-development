<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 44 Chỉnh sửa hồ sơ — Thành viên B.
    B tự viết: EditProfileViewModel → UserRepository (PUT users/me, chỉ gửi field đã đổi), kiểm tra
    chiều cao 100–250 / cân nặng 30–250 (lỗi dưới ô), danh sách chọn cho 4 ô thả xuống, khoá nút Lưu khi đang gửi.
    Hiện tại "Lưu" / "Lưu thay đổi" chỉ quay lại 43.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.AICoach.Auth.BackButton" />

            <TextView
                style="@style/Widget.AICoach.B.ToolbarTitle"
                android:text="@string/profile_edit_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTop"
                style="@style/Widget.AICoach.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_save"
                android:textColor="@color/brand_primary" />
        </LinearLayout>

        <!-- Ảnh đại diện -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="@dimen/b_profile_avatar"
                android:layout_height="@dimen/b_profile_avatar"
                android:background="@drawable/bg_social_avatar_ring"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold"
                tools:text="M" />

            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="@dimen/b_avatar_small"
                android:layout_height="@dimen/b_avatar_small"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_fab_train"
                android:contentDescription="@string/profile_change_avatar"
                android:padding="@dimen/space_8"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera_24"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnChangeAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/space_4"
            android:text="@string/profile_change_avatar"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Họ và tên -->
        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:labelFor="@id/etName"
            android:text="@string/profile_name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            style="@style/Widget.AICoach.Auth.TextInput"
            app:startIconDrawable="@drawable/ic_person_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                style="@style/Widget.AICoach.Auth.EditText"
                android:autofillHints="name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                tools:text="Nguyễn Minh" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email (không sửa được) -->
        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:labelFor="@id/etEmail"
            android:text="@string/profile_email_locked" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.AICoach.Auth.TextInput"
            android:enabled="false"
            app:boxBackgroundColor="@color/bg_input_disabled"
            app:startIconDrawable="@drawable/ic_lock_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                style="@style/Widget.AICoach.Auth.EditText"
                android:inputType="none"
                android:textColor="@color/text_secondary"
                tools:text="minh.nguyen@gmail.com" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Chiều cao | Cân nặng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.AICoach.Auth.Label"
                    android:labelFor="@id/etHeight"
                    android:text="@string/profile_height" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHeight"
                    style="@style/Widget.AICoach.Auth.TextInput"
                    app:suffixText="@string/profile_unit_cm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHeight"
                        style="@style/Widget.AICoach.Auth.EditText"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        tools:text="170" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <Space
                android:layout_width="@dimen/space_12"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.AICoach.Auth.Label"
                    android:labelFor="@id/etWeight"
                    android:text="@string/profile_weight" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWeight"
                    style="@style/Widget.AICoach.Auth.TextInput"
                    app:suffixText="@string/profile_unit_kg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWeight"
                        style="@style/Widget.AICoach.Auth.EditText"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        tools:text="62" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Năm sinh | Giới tính -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.AICoach.Auth.Label"
                    android:labelFor="@id/ddBirthYear"
                    android:text="@string/profile_birth_year" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBirthYear"
                    style="@style/Widget.AICoach.B.Dropdown">

                    <AutoCompleteTextView
                        android:id="@+id/ddBirthYear"
                        style="@style/Widget.AICoach.B.DropdownText"
                        tools:text="2003" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <Space
                android:layout_width="@dimen/space_12"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.AICoach.Auth.Label"
                    android:labelFor="@id/ddGender"
                    android:text="@string/profile_gender" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGender"
                    style="@style/Widget.AICoach.B.Dropdown">

                    <AutoCompleteTextView
                        android:id="@+id/ddGender"
                        style="@style/Widget.AICoach.B.DropdownText"
                        tools:text="Nam" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Mục tiêu -->
        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:labelFor="@id/ddGoal"
            android:text="@string/profile_goal" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGoal"
            style="@style/Widget.AICoach.B.Dropdown"
            app:startIconDrawable="@drawable/ic_fire_24">

            <AutoCompleteTextView
                android:id="@+id/ddGoal"
                style="@style/Widget.AICoach.B.DropdownText"
                tools:text="Giảm mỡ – Bụng, Chân &amp; mông" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Trình độ | Số buổi/tuần (đủ field cho PUT users/me) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.AICoach.Auth.Label"
                    android:labelFor="@id/ddLevel"
                    android:text="@string/profile_level" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLevel"
                    style="@style/Widget.AICoach.B.Dropdown">

                    <AutoCompleteTextView
                        android:id="@+id/ddLevel"
                        style="@style/Widget.AICoach.B.DropdownText"
                        tools:text="Mới bắt đầu" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <Space
                android:layout_width="@dimen/space_12"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.AICoach.Auth.Label"
                    android:labelFor="@id/ddSessions"
                    android:text="@string/profile_weekly_sessions" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSessions"
                    style="@style/Widget.AICoach.B.Dropdown">

                    <AutoCompleteTextView
                        android:id="@+id/ddSessions"
                        style="@style/Widget.AICoach.B.DropdownText"
                        tools:text="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/profile_save_changes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAccount"
            style="@style/Widget.AICoach.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/profile_delete_account"
            android:textColor="@color/state_error" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
