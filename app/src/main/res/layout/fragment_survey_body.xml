<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 13 Khảo sát 1/3 – Thông tin cơ thể (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <include
            android:id="@+id/header"
            layout="@layout/view_survey_header" />

        <TextView
            style="@style/Widget.AICoach.Auth.Title"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/survey_body_title" />

        <TextView
            style="@style/Widget.AICoach.Auth.Subtitle"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/survey_body_subtitle" />

        <!-- Giới tính -->
        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:text="@string/survey_gender" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <include
                android:id="@+id/cardMale"
                layout="@layout/view_survey_gender" />

            <Space
                android:layout_width="@dimen/space_12"
                android:layout_height="0dp" />

            <include
                android:id="@+id/cardFemale"
                layout="@layout/view_survey_gender" />
        </LinearLayout>

        <!-- Năm sinh -->
        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:text="@string/survey_birth_year" />

        <LinearLayout
            android:id="@+id/rowBirthYear"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_survey_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_12">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar_24"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvBirthYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="2003" />

            <TextView
                android:id="@+id/tvAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.AICoach.Caption"
                android:textSize="14sp"
                tools:text="23 tuổi" />

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginStart="@dimen/space_8"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more_24"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Chiều cao -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.AICoach.Survey.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/survey_height" />

            <TextView
                android:id="@+id/tvHeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/survey_big_value_size"
                android:textStyle="bold"
                tools:text="170 cm" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_card_white"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHeight"
                style="@style/Widget.AICoach.Survey.Slider"
                android:contentDescription="@string/survey_height"
                android:stepSize="1"
                android:value="170"
                android:valueFrom="100"
                android:valueTo="250" />
        </FrameLayout>

        <!-- Cân nặng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.AICoach.Survey.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/survey_weight" />

            <TextView
                android:id="@+id/tvWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/survey_big_value_size"
                android:textStyle="bold"
                tools:text="62 kg" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_card_white"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderWeight"
                style="@style/Widget.AICoach.Survey.Slider"
                android:contentDescription="@string/survey_weight"
                android:stepSize="1"
                android:value="62"
                android:valueFrom="30"
                android:valueTo="200" />
        </FrameLayout>

        <!-- BMI tự tính -->
        <LinearLayout
            android:id="@+id/boxBmi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_auth_info_box"
            android:backgroundTint="@color/state_success_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <ImageView
                android:id="@+id/imgBmi"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info_24"
                app:tint="@color/state_success" />

            <TextView
                android:id="@+id/tvBmi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:textColor="@color/state_success"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="BMI 21.5 – Cân nặng bình thường" />
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_24" />

        <include
            android:id="@+id/footer"
            layout="@layout/view_survey_footer" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
