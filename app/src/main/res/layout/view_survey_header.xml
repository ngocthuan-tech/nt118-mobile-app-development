<?xml version="1.0" encoding="utf-8"?>
<!-- Đầu trang khảo sát (Figma 13–15): nút quay lại + "Bước x/3" + 3 vạch tiến độ. Dùng bằng <include>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.AICoach.Auth.BackButton" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Bước 1/3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:orientation="horizontal">

        <View
            android:id="@+id/bar1"
            android:layout_width="0dp"
            android:layout_height="@dimen/survey_bar_height"
            android:layout_weight="1"
            android:background="@drawable/bg_auth_bar"
            android:backgroundTint="@color/divider" />

        <View
            android:id="@+id/bar2"
            android:layout_width="0dp"
            android:layout_height="@dimen/survey_bar_height"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_auth_bar"
            android:backgroundTint="@color/divider" />

        <View
            android:id="@+id/bar3"
            android:layout_width="0dp"
            android:layout_height="@dimen/survey_bar_height"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_auth_bar"
            android:backgroundTint="@color/divider" />
    </LinearLayout>
</LinearLayout>
