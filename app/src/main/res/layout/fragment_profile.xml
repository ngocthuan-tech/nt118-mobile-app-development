<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 43 Hồ sơ & Cài đặt (mở từ avatar Trang chủ) — Thành viên B.
    B tự viết: ProfileViewModel → UserRepository → UserApi (GET users/me) đổ tên, chỉ số, BMI;
    adapter rvBadges (item_badge_small); lưu công tắc vào SettingsPrefs.
    Đã nối: Sửa hồ sơ → 44 · bánh răng / Giọng nói → 45 · "6/20" → 46 · Đổi mật khẩu → hộp thoại · Đăng xuất → 47.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_24">

        <!-- Header xanh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_20"
            android:paddingBottom="@dimen/b_header_bottom_space">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.AICoach.CircleIconButton"
                    android:backgroundTint="@color/white_20"
                    android:contentDescription="@string/profile_back"
                    android:src="@drawable/ic_chevron_left_24"
                    app:tint="@color/white" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    style="@style/Widget.AICoach.CircleIconButton"
                    android:backgroundTint="@color/white_20"
                    android:contentDescription="@string/profile_settings"
                    android:src="@drawable/ic_settings_24"
                    app:tint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="@dimen/b_profile_avatar"
                android:layout_height="@dimen/b_profile_avatar"
                android:background="@drawable/bg_social_avatar_ring"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold"
                tools:text="M" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.AICoach.OnDark.Title"
                tools:text="Nguyễn Minh" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption"
                tools:text="Giảm mỡ • Mới bắt đầu • Tham gia 09/2026" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.AICoach.Button.OnDark"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/space_12"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="36dp"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="@string/profile_edit"
                android:textSize="13sp"
                app:icon="@drawable/ic_edit_24"
                app:iconSize="14dp" />
        </LinearLayout>

        <!-- 3 chỉ số chồng lên header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_20"
            android:layout_marginTop="@dimen/b_stats_overlap"
            android:layout_marginEnd="@dimen/space_20"
            android:background="@drawable/bg_card_white"
            android:divider="@drawable/divider_vertical"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_16"
            android:paddingBottom="@dimen/space_16"
            android:showDividers="middle">

            <LinearLayout style="@style/Widget.AICoach.B.ProfileStat">

                <ImageView
                    style="@style/Widget.AICoach.B.ProfileStatIcon"
                    android:src="@drawable/ic_fire_24"
                    app:tint="@color/medal_orange" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStreak"
                        style="@style/Widget.AICoach.B.MiniValue"
                        android:textSize="20sp"
                        tools:text="7" />

                    <TextView
                        style="@style/Widget.AICoach.B.StatLabel"
                        android:text="@string/profile_stat_streak" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Widget.AICoach.B.ProfileStat">

                <ImageView
                    style="@style/Widget.AICoach.B.ProfileStatIcon"
                    android:src="@drawable/ic_dumbbell_24"
                    app:tint="@color/brand_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSessions"
                        style="@style/Widget.AICoach.B.MiniValue"
                        android:textSize="20sp"
                        tools:text="24" />

                    <TextView
                        style="@style/Widget.AICoach.B.StatLabel"
                        android:text="@string/profile_stat_sessions" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Widget.AICoach.B.ProfileStat">

                <ImageView
                    style="@style/Widget.AICoach.B.ProfileStatIcon"
                    android:src="@drawable/ic_medal_24"
                    app:tint="@color/accent_cyan" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBadgeCount"
                        style="@style/Widget.AICoach.B.MiniValue"
                        android:textSize="20sp"
                        tools:text="6" />

                    <TextView
                        style="@style/Widget.AICoach.B.StatLabel"
                        android:text="@string/profile_stat_badges" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingEnd="@dimen/space_20">

            <!-- Chỉ số cơ thể (từ GET users/me) -->
            <TextView
                style="@style/Widget.AICoach.Survey.Section"
                android:text="@string/profile_body_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.AICoach.B.StatBox">

                    <TextView
                        style="@style/Widget.AICoach.B.StatLabel"
                        android:text="@string/profile_height" />

                    <TextView
                        android:id="@+id/tvHeight"
                        style="@style/Widget.AICoach.B.StatValue"
                        android:textSize="18sp"
                        tools:text="170 cm" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/space_8"
                    android:layout_height="0dp" />

                <LinearLayout style="@style/Widget.AICoach.B.StatBox">

                    <TextView
                        style="@style/Widget.AICoach.B.StatLabel"
                        android:text="@string/profile_weight" />

                    <TextView
                        android:id="@+id/tvWeight"
                        style="@style/Widget.AICoach.B.StatValue"
                        android:textSize="18sp"
                        tools:text="62 kg" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/space_8"
                    android:layout_height="0dp" />

                <LinearLayout style="@style/Widget.AICoach.B.StatBox">

                    <TextView
                        style="@style/Widget.AICoach.B.StatLabel"
                        android:text="@string/profile_bmi" />

                    <TextView
                        android:id="@+id/tvBmi"
                        style="@style/Widget.AICoach.B.StatValue"
                        android:textColor="@color/state_success"
                        android:textSize="18sp"
                        tools:text="21.5" />

                    <TextView
                        android:id="@+id/tvBmiNote"
                        style="@style/Widget.AICoach.B.StatLabel"
                        android:textSize="11sp"
                        tools:text="Bình thường" />
                </LinearLayout>
            </LinearLayout>

            <!-- Huy hiệu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.AICoach.Survey.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/profile_badges_title" />

                <TextView
                    android:id="@+id/btnAllBadges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_4"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="6/20" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:minHeight="76dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_badge_small" />

            <!-- Cài đặt -->
            <TextView
                style="@style/Widget.AICoach.Survey.Section"
                android:text="@string/profile_settings_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_4">

                <LinearLayout
                    android:id="@+id/rowVoice"
                    style="@style/Widget.AICoach.B.SettingRow">

                    <ImageView
                        style="@style/Widget.AICoach.B.SettingIcon"
                        android:src="@drawable/ic_volume_24" />

                    <TextView
                        style="@style/Widget.AICoach.B.SettingText"
                        android:text="@string/profile_voice" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchVoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/profile_voice" />
                </LinearLayout>

                <View style="@style/Widget.AICoach.B.Divider" />

                <LinearLayout
                    android:id="@+id/rowReminder"
                    style="@style/Widget.AICoach.B.SettingRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/Widget.AICoach.B.SettingIcon"
                        android:src="@drawable/ic_bell_24" />

                    <TextView
                        style="@style/Widget.AICoach.B.SettingText"
                        android:text="@string/profile_reminder" />

                    <TextView
                        android:id="@+id/tvReminder"
                        style="@style/Widget.AICoach.B.SettingValue"
                        tools:text="19:00 hằng ngày" />

                    <ImageView style="@style/Widget.AICoach.B.Chevron" />
                </LinearLayout>

                <View style="@style/Widget.AICoach.B.Divider" />

                <LinearLayout style="@style/Widget.AICoach.B.SettingRow">

                    <ImageView
                        style="@style/Widget.AICoach.B.SettingIcon"
                        android:src="@drawable/ic_camera_24" />

                    <TextView
                        style="@style/Widget.AICoach.B.SettingText"
                        android:text="@string/profile_auto_check" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/profile_auto_check" />
                </LinearLayout>

                <View style="@style/Widget.AICoach.B.Divider" />

                <LinearLayout
                    android:id="@+id/rowPassword"
                    style="@style/Widget.AICoach.B.SettingRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/Widget.AICoach.B.SettingIcon"
                        android:src="@drawable/ic_key_24" />

                    <TextView
                        style="@style/Widget.AICoach.B.SettingText"
                        android:text="@string/profile_change_password" />

                    <ImageView style="@style/Widget.AICoach.B.Chevron" />
                </LinearLayout>

                <View style="@style/Widget.AICoach.B.Divider" />

                <LinearLayout style="@style/Widget.AICoach.B.SettingRow">

                    <ImageView
                        style="@style/Widget.AICoach.B.SettingIcon"
                        android:src="@drawable/ic_shield_24" />

                    <TextView
                        style="@style/Widget.AICoach.B.SettingText"
                        android:text="@string/profile_privacy" />

                    <TextView
                        style="@style/Widget.AICoach.B.SettingValue"
                        android:text="@string/profile_privacy_value" />

                    <ImageView style="@style/Widget.AICoach.B.Chevron" />
                </LinearLayout>

                <View style="@style/Widget.AICoach.B.Divider" />

                <LinearLayout style="@style/Widget.AICoach.B.SettingRow">

                    <ImageView
                        style="@style/Widget.AICoach.B.SettingIcon"
                        android:src="@drawable/ic_language_24" />

                    <TextView
                        style="@style/Widget.AICoach.B.SettingText"
                        android:text="@string/profile_language" />

                    <TextView
                        style="@style/Widget.AICoach.B.SettingValue"
                        android:text="@string/profile_language_value" />

                    <ImageView style="@style/Widget.AICoach.B.Chevron" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_20"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/profile_logout"
                android:textColor="@color/state_error"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/state_error_light"
                app:cornerRadius="@dimen/radius_card"
                app:icon="@drawable/ic_logout_24"
                app:iconGravity="textStart"
                app:iconTint="@color/state_error" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
