<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 37 Lịch sử & Biểu đồ (tab "Tiến độ") — Thành viên B.
    Giao diện + điều hướng đã dựng. B tự viết: HistoryViewModel → HistoryRepository → SessionApi (GET sessions?limit=50),
    adapter cho rvSessions (item_history_session), dữ liệu cho chartReps (MPAndroidChart BarChart).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_20"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/progress_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/b_title_size"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCalendar"
                style="@style/Widget.AICoach.B.RoundIconButton"
                android:contentDescription="@string/progress_open_calendar"
                android:src="@drawable/ic_calendar_24" />
        </LinearLayout>

        <!-- Tuần / Tháng / Năm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_survey_segment"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWeek"
                style="@style/Widget.AICoach.Segment"
                android:checked="true"
                android:text="@string/progress_tab_week" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMonth"
                style="@style/Widget.AICoach.Segment"
                android:text="@string/progress_tab_month" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnYear"
                style="@style/Widget.AICoach.Segment"
                android:text="@string/progress_tab_year" />
        </LinearLayout>

        <!-- 3 chỉ số -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <LinearLayout style="@style/Widget.AICoach.B.StatBox">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dumbbell_24"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/tvSessions"
                    style="@style/Widget.AICoach.B.StatValue"
                    tools:text="5" />

                <TextView
                    style="@style/Widget.AICoach.B.StatLabel"
                    android:text="@string/progress_stat_sessions" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/space_8"
                android:layout_height="0dp" />

            <LinearLayout style="@style/Widget.AICoach.B.StatBox">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_target_24"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/tvReps"
                    style="@style/Widget.AICoach.B.StatValue"
                    tools:text="1.120" />

                <TextView
                    style="@style/Widget.AICoach.B.StatLabel"
                    android:text="@string/progress_stat_reps" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/space_8"
                android:layout_height="0dp" />

            <LinearLayout style="@style/Widget.AICoach.B.StatBox">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_medal_24"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/tvAvgScore"
                    style="@style/Widget.AICoach.B.StatValue"
                    tools:text="86" />

                <TextView
                    style="@style/Widget.AICoach.B.StatLabel"
                    android:text="@string/progress_stat_score" />
            </LinearLayout>
        </LinearLayout>

        <!-- Biểu đồ cột số lần tập 7 ngày -->
        <LinearLayout
            style="@style/Widget.AICoach.B.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_chart_title"
                android:textAppearance="@style/TextAppearance.AICoach.SectionTitle" />

            <TextView
                android:id="@+id/tvTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_chip_light"
                android:backgroundTint="@color/state_success_light"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/space_8"
                android:paddingBottom="@dimen/space_2"
                android:textColor="@color/state_success"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="+18% so với tuần trước" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/chartReps"
                android:layout_width="match_parent"
                android:layout_height="@dimen/b_chart_height"
                android:layout_marginTop="@dimen/space_12" />
        </LinearLayout>

        <!-- Lịch sử buổi tập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/progress_history_title"
                android:textAppearance="@style/TextAppearance.AICoach.SectionTitle" />

            <TextView
                android:id="@+id/btnSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/space_4"
                android:text="@string/common_see_all"
                android:textColor="@color/brand_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_history_session" />

        <!-- Trạng thái rỗng: tài khoản mới chưa tập buổi nào (B bật khi danh sách trống) -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_card_white"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_24"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chart_24"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/progress_empty_title"
                android:textAppearance="@style/TextAppearance.AICoach.SectionTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="@string/progress_empty_desc"
                android:textAppearance="@style/TextAppearance.AICoach.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFirstWorkout"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_16"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="@dimen/space_24"
                android:paddingEnd="@dimen/space_24"
                android:text="@string/progress_empty_action" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
