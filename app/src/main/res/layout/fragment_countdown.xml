<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 29 "Đếm ngược bắt đầu" (Trưởng nhóm): 3 → 2 → 1 rồi tự vào màn tập. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_dark"
    android:padding="@dimen/space_20">

    <TextView
        android:id="@+id/chipReady"
        style="@style/Widget.AICoach.ChipDark"
        android:backgroundTint="@color/state_success"
        android:drawableStart="@drawable/ic_check_24"
        android:textColor="@color/white"
        app:drawableTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Sẵn sàng 3/3" />

    <FrameLayout
        android:id="@+id/countdownRing"
        android:layout_width="@dimen/countdown_ring_size"
        android:layout_height="@dimen/countdown_ring_size"
        android:layout_marginTop="@dimen/space_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipReady">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_body_24"
            app:tint="@color/state_success" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressCountdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="3000"
            app:indicatorColor="@color/brand_sky"
            app:indicatorSize="@dimen/countdown_ring_size"
            app:trackColor="@color/white_20"
            app:trackCornerRadius="6dp"
            app:trackThickness="10dp"
            tools:progress="2000" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="110sp"
            android:textStyle="bold"
            tools:text="3" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGetReady"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/workout_get_ready"
        android:textAppearance="@style/TextAppearance.AICoach.OnDark.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/countdownRing" />

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGetReady"
        tools:text="Squat • Hiệp 1/3 • Mục tiêu 15 lần" />

    <include
        android:id="@+id/voicePrompt"
        layout="@layout/view_voice_prompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMeta" />

    <!-- 2 mẹo tư thế -->
    <LinearLayout
        android:id="@+id/rowTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/voicePrompt">

        <TextView
            style="@style/Widget.AICoach.ChipDark"
            android:drawableStart="@drawable/ic_standing_24"
            android:text="@string/workout_tip_side"
            android:textSize="12sp"
            app:drawableTint="@color/accent_cyan" />

        <TextView
            style="@style/Widget.AICoach.ChipDark"
            android:layout_marginStart="@dimen/space_8"
            android:drawableStart="@drawable/ic_frame_24"
            android:text="@string/workout_tip_feet"
            android:textSize="12sp"
            app:drawableTint="@color/accent_cyan" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.AICoach.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/workout_cancel"
        android:textColor="@color/text_on_dark_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
