<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 14 Khảo sát 2/3 – Mục tiêu (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <include
            android:id="@+id/header"
            layout="@layout/view_survey_header" />

        <TextView
            style="@style/Widget.AICoach.Auth.Title"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/survey_goal_title" />

        <TextView
            style="@style/Widget.AICoach.Auth.Subtitle"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/survey_goal_subtitle" />

        <include
            android:id="@+id/optionLose"
            layout="@layout/view_survey_option" />

        <include
            android:id="@+id/optionMuscle"
            layout="@layout/view_survey_option" />

        <include
            android:id="@+id/optionFit"
            layout="@layout/view_survey_option" />

        <include
            android:id="@+id/optionEndurance"
            layout="@layout/view_survey_option" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_focus_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:text="@string/survey_focus_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupFocus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:chipSpacingHorizontal="@dimen/space_8">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAbs"
                style="@style/Widget.AICoach.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_focus_abs" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLegs"
                style="@style/Widget.AICoach.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_focus_legs" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipArms"
                style="@style/Widget.AICoach.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_focus_arms" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipChest"
                style="@style/Widget.AICoach.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_focus_chest" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBack"
                style="@style/Widget.AICoach.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_focus_back" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFull"
                style="@style/Widget.AICoach.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_focus_full" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Gợi ý của AI theo mục tiêu đang chọn -->
        <include
            android:id="@+id/aiNote"
            layout="@layout/view_ai_note" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_24" />

        <include
            android:id="@+id/footer"
            layout="@layout/view_survey_footer" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
