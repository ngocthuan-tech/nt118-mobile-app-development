<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 38 Lịch tập tháng — Thành viên B.
    B tự viết: tô ngày từ danh sách sessions (rvDays, 7 cột, item_calendar_day), các chỉ số tháng, buổi gần nhất.
    Thẻ buổi gần nhất (cardLatest) đã nối sang 39 Chi tiết buổi tập.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.AICoach.Auth.BackButton" />

            <TextView
                style="@style/Widget.AICoach.B.ToolbarTitle"
                android:text="@string/progress_calendar_title" />
        </LinearLayout>

        <!-- Lịch -->
        <LinearLayout
            style="@style/Widget.AICoach.B.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="@dimen/circle_button_size"
                    android:layout_height="@dimen/circle_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/progress_prev_month"
                    android:src="@drawable/ic_chevron_left_24"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvMonth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Tháng 10, 2026" />

                <ImageButton
                    android:id="@+id/btnNextMonth"
                    android:layout_width="@dimen/circle_button_size"
                    android:layout_height="@dimen/circle_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/progress_next_month"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- T2 … CN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <TextView style="@style/Widget.AICoach.B.WeekdayLabel" android:text="@string/day_mon" />
                <TextView style="@style/Widget.AICoach.B.WeekdayLabel" android:text="@string/day_tue" />
                <TextView style="@style/Widget.AICoach.B.WeekdayLabel" android:text="@string/day_wed" />
                <TextView style="@style/Widget.AICoach.B.WeekdayLabel" android:text="@string/day_thu" />
                <TextView style="@style/Widget.AICoach.B.WeekdayLabel" android:text="@string/day_fri" />
                <TextView style="@style/Widget.AICoach.B.WeekdayLabel" android:text="@string/day_sat" />
                <TextView style="@style/Widget.AICoach.B.WeekdayLabel" android:text="@string/day_sun" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="7"
                tools:itemCount="35"
                tools:listitem="@layout/item_calendar_day" />

            <!-- Chú thích -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.AICoach.B.Legend"
                    android:text="@string/progress_legend_done"
                    app:drawableStartCompat="@drawable/bg_progress_done_dot" />

                <TextView
                    style="@style/Widget.AICoach.B.Legend"
                    android:text="@string/progress_legend_planned"
                    app:drawableStartCompat="@drawable/bg_progress_planned_dot" />

                <TextView
                    style="@style/Widget.AICoach.B.Legend"
                    android:text="@string/progress_legend_today"
                    app:drawableStartCompat="@drawable/bg_progress_today_ring" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3 chỉ số của tháng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <LinearLayout style="@style/Widget.AICoach.B.StatBox">

                <TextView
                    android:id="@+id/tvMonthSessions"
                    style="@style/Widget.AICoach.B.StatValue"
                    tools:text="9" />

                <TextView
                    style="@style/Widget.AICoach.B.StatLabel"
                    android:text="@string/progress_stat_sessions" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/space_8"
                android:layout_height="0dp" />

            <LinearLayout style="@style/Widget.AICoach.B.StatBox">

                <TextView
                    android:id="@+id/tvMonthTime"
                    style="@style/Widget.AICoach.B.StatValue"
                    tools:text="3g 12p" />

                <TextView
                    style="@style/Widget.AICoach.B.StatLabel"
                    android:text="@string/progress_stat_time" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/space_8"
                android:layout_height="0dp" />

            <LinearLayout style="@style/Widget.AICoach.B.StatBox">

                <TextView
                    android:id="@+id/tvMonthKcal"
                    style="@style/Widget.AICoach.B.StatValue"
                    tools:text="2.640" />

                <TextView
                    style="@style/Widget.AICoach.B.StatLabel"
                    android:text="@string/progress_stat_kcal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chuỗi ngày -->
        <LinearLayout
            style="@style/Widget.AICoach.B.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_streak_icon">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_fire_24"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.AICoach.SectionTitle"
                    tools:text="7 ngày liên tiếp" />

                <TextView
                    android:id="@+id/tvStreakNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.AICoach.Caption"
                    tools:text="Đang phá kỷ lục cũ (6 ngày)!" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buổi tập gần nhất → 39 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLatest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <ImageView
                    android:id="@+id/imgLatest"
                    android:layout_width="@dimen/b_list_thumb"
                    android:layout_height="@dimen/b_list_thumb"
                    android:background="@drawable/bg_exercise_photo"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/img_squat" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLatestDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AICoach.Caption"
                        tools:text="Thứ 7, 10/10 • 19:30" />

                    <TextView
                        android:id="@+id/tvLatestTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Squat • 45 lần • 92 điểm" />
                </LinearLayout>

                <ImageView style="@style/Widget.AICoach.B.Chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
