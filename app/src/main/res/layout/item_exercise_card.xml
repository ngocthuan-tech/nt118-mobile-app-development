<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ bài tập (Figma 08: "Bài tập Squat / Hít đất / Plank") — dùng lại ở Thư viện bài tập -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/exercise_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_12"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_8">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/exercise_card_image_height">

            <ImageView
                android:id="@+id/imgExercise"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_placeholder"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/chipAi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_8"
                android:background="@drawable/bg_chip_light"
                android:paddingStart="@dimen/space_8"
                android:paddingEnd="@dimen/space_8"
                android:paddingTop="@dimen/space_2"
                android:paddingBottom="@dimen/space_2"
                android:text="@string/home_ai_chip"
                android:textColor="@color/brand_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvExerciseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.AICoach.SectionTitle"
            tools:text="Squat" />

        <TextView
            android:id="@+id/tvExerciseVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.AICoach.Caption"
            tools:text="3 × 15 lần" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
