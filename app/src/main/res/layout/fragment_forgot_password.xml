<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 08 Quên mật khẩu (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_16">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.AICoach.Auth.BackButton" />

        <include
            android:id="@+id/icon"
            layout="@layout/view_auth_icon_halo"
            android:layout_width="@dimen/auth_icon_halo_size"
            android:layout_height="@dimen/auth_icon_halo_size"
            android:layout_gravity="center_horizontal" />

        <TextView
            style="@style/Widget.AICoach.Auth.Title"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/auth_forgot_title" />

        <TextView
            style="@style/Widget.AICoach.Auth.Subtitle"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="@string/auth_forgot_desc" />

        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:layout_marginTop="@dimen/space_24"
            android:labelFor="@id/etEmail"
            android:text="@string/auth_forgot_email_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.AICoach.Auth.TextInput"
            app:startIconDrawable="@drawable/ic_mail_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                style="@style/Widget.AICoach.Auth.EditText"
                android:autofillHints="emailAddress"
                android:imeOptions="actionSend"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_auth_info_box"
            android:backgroundTint="@color/brand_primary_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <ImageView
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info_24"
                app:tint="@color/brand_primary" />

            <TextView
                android:id="@+id/tvCodeValid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:textColor="@color/brand_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_32" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/auth_forgot_send"
                app:icon="@drawable/ic_send_24"
                app:iconSize="@dimen/icon_size_small" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="10dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/brand_primary"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToLogin"
            style="@style/Widget.AICoach.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_12"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/auth_back_to_login" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
