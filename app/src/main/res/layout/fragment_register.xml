<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 12 Tạo tài khoản (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/auth_horizontal_padding"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/auth_horizontal_padding"
        android:paddingBottom="@dimen/space_16">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.AICoach.Auth.BackButton" />

        <TextView
            style="@style/Widget.AICoach.Auth.Title"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/auth_register_title" />

        <TextView
            style="@style/Widget.AICoach.Auth.Subtitle"
            android:text="@string/auth_register_subtitle" />

        <!-- Họ và tên -->
        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:layout_marginTop="@dimen/space_24"
            android:labelFor="@id/etName"
            android:text="@string/auth_name_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            style="@style/Widget.AICoach.Auth.TextInput"
            app:startIconDrawable="@drawable/ic_person_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                style="@style/Widget.AICoach.Auth.EditText"
                android:autofillHints="name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email -->
        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:labelFor="@id/etEmail"
            android:text="@string/auth_email_hint" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.AICoach.Auth.TextInput"
            app:startIconDrawable="@drawable/ic_mail_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                style="@style/Widget.AICoach.Auth.EditText"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Mật khẩu + độ mạnh -->
        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:labelFor="@id/etPassword"
            android:text="@string/auth_password_hint" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.AICoach.Auth.TextInput"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                style="@style/Widget.AICoach.Auth.EditText"
                android:autofillHints="newPassword"
                android:imeOptions="actionNext"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <include
            android:id="@+id/strength"
            layout="@layout/view_password_strength" />

        <!-- Nhập lại mật khẩu -->
        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:labelFor="@id/etConfirm"
            android:text="@string/auth_confirm_password_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirm"
            style="@style/Widget.AICoach.Auth.TextInput"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirm"
                style="@style/Widget.AICoach.Auth.EditText"
                android:autofillHints="newPassword"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Đồng ý điều khoản -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/auth_terms_agree"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:buttonTint="@color/brand_primary" />

        <TextView
            android:id="@+id/tvTermsError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_error_terms"
            android:textColor="@color/state_error"
            android:textSize="12sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/auth_register_button" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="10dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/brand_primary"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />
        </FrameLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_24" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_have_account"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.AICoach.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/space_8"
                android:paddingEnd="@dimen/space_8"
                android:text="@string/auth_login_link"
                android:textColor="@color/brand_primary" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
