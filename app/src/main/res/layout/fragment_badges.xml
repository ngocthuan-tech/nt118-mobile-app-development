<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 46 Bộ sưu tập huy hiệu — Thành viên B.
    B tự viết: BadgeRules (tính huy hiệu từ lịch sử tập, có unit test), BadgeAdapter dùng item_badge,
    lọc theo 3 nút Tất cả / Đã đạt / Chưa đạt, số "6/20" + gợi ý huy hiệu gần đạt nhất.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.AICoach.Auth.BackButton" />

        <TextView
            style="@style/Widget.AICoach.B.ToolbarTitle"
            android:text="@string/profile_badges_screen" />
    </LinearLayout>

    <!-- Tổng kết: 6/20 huy hiệu + thanh tiến độ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_social_card_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <FrameLayout
            android:layout_width="@dimen/b_badge_small"
            android:layout_height="@dimen/b_badge_small"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/state_warning">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_medal_24"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="6/20 huy hiệu" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:indicatorColor="@color/accent_cyan"
                app:trackColor="@color/white_20"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp"
                tools:progress="30" />

            <TextView
                android:id="@+id/tvNextHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption"
                tools:text="Còn 1 buổi nữa để mở “10 buổi tập”" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lọc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_survey_segment"
        android:orientation="horizontal"
        android:padding="@dimen/space_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAll"
            style="@style/Widget.AICoach.Segment"
            android:checked="true"
            android:text="@string/profile_badges_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEarned"
            style="@style/Widget.AICoach.Segment"
            android:text="@string/profile_badges_earned"
            tools:text="Đã đạt (6)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocked"
            style="@style/Widget.AICoach.Segment"
            android:text="@string/profile_badges_locked" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBadges"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_8"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:itemCount="12"
        tools:listitem="@layout/item_badge" />
</LinearLayout>
