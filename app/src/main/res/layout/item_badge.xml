<?xml version="1.0" encoding="utf-8"?>
<!--
    Một ô huy hiệu trong lưới Figma 46.
    Đã đạt: circle tô màu riêng + icon trắng, ẩn imgLock và progress.
    Chưa đạt: circle nền xám (bg_input_disabled), icon xám, hiện imgLock + progress nếu có tiến độ.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_8">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/circle"
            android:layout_width="@dimen/b_badge_large"
            android:layout_height="@dimen/b_badge_large"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/bg_input_disabled"
            tools:backgroundTint="@color/state_success">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/white"
                tools:src="@drawable/ic_target_24" />
        </FrameLayout>

        <ImageView
            android:id="@+id/imgLock"
            android:layout_width="@dimen/space_20"
            android:layout_height="@dimen/space_20"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/white"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_4"
            android:src="@drawable/ic_lock_24"
            android:visibility="gone"
            app:tint="@color/text_secondary"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Khởi đầu" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.AICoach.Caption"
        tools:text="Buổi đầu tiên" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:visibility="gone"
        app:indicatorColor="@color/brand_primary"
        app:trackColor="@color/divider"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp"
        tools:progress="90" />
</LinearLayout>
