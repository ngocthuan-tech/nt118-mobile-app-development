<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout TẠM dùng chung cho các màn chưa làm. Khi làm màn thật, mỗi người tạo
    layout riêng (fragment_<tên>.xml) theo Figma rồi đổi Fragment sang binding mới.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.AICoach.Title"
        tools:text="Tiêu đề màn" />

    <TextView
        android:id="@+id/tvOwner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.AICoach.Caption"
        tools:text="Phụ trách: Thành viên A" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:visibility="gone"
        tools:text="Hành động"
        tools:visibility="visible" />

</LinearLayout>
