<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 45 Giọng nói & âm thanh — Thành viên B.
    B tự viết: đọc/ghi SettingsPrefs (isVoiceEnabled — module AI của Trưởng nhóm đọc giá trị này),
    chọn 1 trong 3 giọng (bỏ chọn radio còn lại), nghe thử bằng TextToSpeech, 2 thanh trượt, 4 ô chọn.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.AICoach.Auth.BackButton" />

            <TextView
                style="@style/Widget.AICoach.B.ToolbarTitle"
                android:text="@string/profile_voice_title" />
        </LinearLayout>

        <!-- Bật / tắt nhắc bằng giọng nói -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_social_card_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <FrameLayout
                android:layout_width="@dimen/icon_circle_size"
                android:layout_height="@dimen/icon_circle_size"
                android:background="@drawable/bg_icon_box"
                android:backgroundTint="@color/white_20">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_volume_24"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_voice_hero"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_voice_hero_desc"
                    android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:contentDescription="@string/profile_voice_hero" />
        </LinearLayout>

        <!-- Giọng đọc -->
        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:text="@string/profile_voice_choose" />

        <LinearLayout
            android:id="@+id/optionFemaleNorth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_survey_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioFemaleNorth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:buttonTint="@color/brand_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_voice_female_north"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_voice_female_north_desc"
                    android:textAppearance="@style/TextAppearance.AICoach.Caption" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPlayFemaleNorth"
                android:layout_width="@dimen/b_avatar_small"
                android:layout_height="@dimen/b_avatar_small"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/brand_primary_light"
                android:contentDescription="@string/profile_voice_preview"
                android:padding="@dimen/space_8"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_24"
                app:tint="@color/brand_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionMaleNorth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_survey_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioMaleNorth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:buttonTint="@color/brand_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_voice_male_north"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_voice_male_north_desc"
                    android:textAppearance="@style/TextAppearance.AICoach.Caption" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPlayMaleNorth"
                android:layout_width="@dimen/b_avatar_small"
                android:layout_height="@dimen/b_avatar_small"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/brand_primary_light"
                android:contentDescription="@string/profile_voice_preview"
                android:padding="@dimen/space_8"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_24"
                app:tint="@color/brand_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionFemaleSouth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_survey_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioFemaleSouth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:buttonTint="@color/brand_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_voice_female_south"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_voice_female_south_desc"
                    android:textAppearance="@style/TextAppearance.AICoach.Caption" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPlayFemaleSouth"
                android:layout_width="@dimen/b_avatar_small"
                android:layout_height="@dimen/b_avatar_small"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/brand_primary_light"
                android:contentDescription="@string/profile_voice_preview"
                android:padding="@dimen/space_8"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_24"
                app:tint="@color/brand_primary" />
        </LinearLayout>

        <!-- Tốc độ đọc -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.AICoach.Survey.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/profile_voice_speed" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="1.0×" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSpeed"
            style="@style/Widget.AICoach.Survey.Slider"
            android:contentDescription="@string/profile_voice_speed"
            android:stepSize="0.1"
            android:value="1.0"
            android:valueFrom="0.5"
            android:valueTo="2.0" />

        <!-- Âm lượng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.AICoach.Survey.Section"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/space_8"
                android:layout_weight="1"
                android:text="@string/profile_voice_volume" />

            <TextView
                android:id="@+id/tvVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="70%" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderVolume"
            style="@style/Widget.AICoach.Survey.Slider"
            android:contentDescription="@string/profile_voice_volume"
            android:stepSize="5"
            android:value="70"
            android:valueFrom="0"
            android:valueTo="100" />

        <!-- AI sẽ nhắc khi -->
        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/profile_voice_when" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minWidth="0dp"
                        app:buttonTint="@color/brand_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_voice_count"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_voice_count_sample"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <View style="@style/Widget.AICoach.B.Divider" android:layout_marginStart="@dimen/space_48" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbForm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minWidth="0dp"
                        app:buttonTint="@color/brand_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_voice_form"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_voice_form_sample"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <View style="@style/Widget.AICoach.B.Divider" android:layout_marginStart="@dimen/space_48" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbPraise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minWidth="0dp"
                        app:buttonTint="@color/brand_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_voice_praise"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_voice_praise_sample"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <View style="@style/Widget.AICoach.B.Divider" android:layout_marginStart="@dimen/space_48" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbRest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:minWidth="0dp"
                        app:buttonTint="@color/brand_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_voice_rest"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_voice_rest_sample"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="italic" />
                </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
