<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 05 Chào mừng (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_16">

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_48" />

        <ImageView
            android:layout_width="@dimen/welcome_logo_size"
            android:layout_height="@dimen/welcome_logo_size"
            android:elevation="12dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/img_logo_tile" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/welcome_title"
            android:textAppearance="@style/TextAppearance.AICoach.OnDark.Title"
            android:textSize="@dimen/welcome_title_size" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/welcome_subtitle"
            android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="vertical">

            <include
                android:id="@+id/rowCount"
                layout="@layout/view_welcome_feature" />

            <include
                android:id="@+id/rowForm"
                layout="@layout/view_welcome_feature" />

            <include
                android:id="@+id/rowVoice"
                layout="@layout/view_welcome_feature" />
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_32" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/welcome_login" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.AICoach.Button.OnDark"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_12"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/welcome_register" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:gravity="center"
            android:text="@string/welcome_terms"
            android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption"
            android:textSize="11sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
