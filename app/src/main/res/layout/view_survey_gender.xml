<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ chọn giới tính (Figma 13). Dùng bằng <include>. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_survey_option"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/space_12">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/avatar"
            android:layout_width="@dimen/survey_gender_avatar"
            android:layout_height="@dimen/survey_gender_avatar"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/brand_primary_light">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person_24"
                app:tint="@color/brand_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="@string/survey_gender_male" />
    </LinearLayout>

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:buttonTint="@color/brand_primary" />
</FrameLayout>
