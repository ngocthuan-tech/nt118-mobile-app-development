<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 23 Thư viện bài tập (tab "Bài tập") — Thành viên A -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_20"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginEnd="@dimen/space_20"
        android:text="@string/exercise_library_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/auth_title_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.AICoach.Caption"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:text="9 bài tập • tất cả đều có AI theo dõi" />

    <!-- Ô tìm kiếm + nút bộ lọc -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        style="@style/Widget.AICoach.Auth.TextInput"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/space_20"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_12"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search_24"
        app:layout_constraintEnd_toStartOf="@id/btnFilter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            style="@style/Widget.AICoach.Auth.EditText"
            android:hint="@string/exercise_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColorHint="@color/text_secondary" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:id="@+id/btnFilter"
        android:layout_width="@dimen/exercise_filter_button_size"
        android:layout_height="@dimen/exercise_filter_button_size"
        android:layout_marginEnd="@dimen/space_20"
        android:background="@drawable/bg_exercise_filter_button"
        android:clickable="true"
        android:contentDescription="@string/exercise_filter"
        android:elevation="4dp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/tilSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tilSearch">

        <ImageView
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_filter_24"
            app:tint="@color/white" />

        <View
            android:id="@+id/dotFilter"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/space_8"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/accent_cyan"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Chip nhóm cơ: Tất cả (9) · Chân & mông · Ngực & tay · Bụng & lưng · Toàn thân -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_20"
        android:paddingEnd="@dimen/space_20"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilSearch">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_8"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExercises"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_32"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollChips"
        app:spanCount="3"
        tools:itemCount="9"
        tools:listitem="@layout/item_exercise_grid" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/brand_primary"
        app:layout_constraintBottom_toBottomOf="@id/rvExercises"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvExercises" />

    <!-- Rỗng / lỗi -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_32"
        android:layout_marginEnd="@dimen/space_32"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvExercises"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvExercises"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/imgEmpty"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search_24"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:text="@string/exercise_empty"
            android:textAppearance="@style/TextAppearance.AICoach.SectionTitle" />

        <TextView
            android:id="@+id/tvEmptyDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:text="@string/exercise_empty_hint"
            android:textAppearance="@style/TextAppearance.AICoach.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyAction"
            style="@style/Widget.AICoach.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:text="@string/exercise_clear_filters" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
