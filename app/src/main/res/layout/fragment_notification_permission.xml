<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 20 Bật thông báo nhắc tập (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_32"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <!-- Chuông trong vòng sáng + chấm đỏ số 1 -->
        <FrameLayout
            android:layout_width="@dimen/notify_bell_halo"
            android:layout_height="@dimen/notify_bell_halo">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_auth_icon_halo" />

            <ImageView
                android:layout_width="@dimen/notify_bell_icon"
                android:layout_height="@dimen/notify_bell_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bell_24"
                app:tint="@color/white" />

            <TextView
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/space_20"
                android:layout_marginEnd="@dimen/space_20"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/state_error"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </FrameLayout>

        <!-- Xem trước thông báo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <ImageView
                android:layout_width="@dimen/icon_circle_size"
                android:layout_height="@dimen/icon_circle_size"
                android:importantForAccessibility="no"
                android:src="@drawable/img_logo_tile" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notify_preview_app"
                    android:textAppearance="@style/TextAppearance.AICoach.Caption" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notify_preview_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notify_preview_body"
                    android:textAppearance="@style/TextAppearance.AICoach.Caption" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Widget.AICoach.Auth.Title"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center"
            android:text="@string/notify_title" />

        <TextView
            style="@style/Widget.AICoach.Auth.Subtitle"
            android:gravity="center"
            android:text="@string/notify_desc" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:background="@drawable/bg_card_white"
            android:divider="@drawable/divider_horizontal_auth"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_12"
            android:showDividers="middle">

            <include
                android:id="@+id/rowReminder"
                layout="@layout/view_notify_row" />

            <include
                android:id="@+id/rowSocial"
                layout="@layout/view_notify_row" />

            <include
                android:id="@+id/rowWeekly"
                layout="@layout/view_notify_row" />
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnable"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/notify_enable"
            app:icon="@drawable/ic_bell_24"
            app:iconSize="@dimen/icon_size_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkip"
            style="@style/Widget.AICoach.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/notify_skip" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
