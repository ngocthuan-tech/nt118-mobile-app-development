<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 09 Nhập mã xác thực (Thành viên A). 6 ô hiển thị + 1 ô nhập ẩn nhận bàn phím số của hệ thống. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_16">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.AICoach.Auth.BackButton" />

        <include
            android:id="@+id/icon"
            layout="@layout/view_auth_icon_halo"
            android:layout_width="@dimen/auth_icon_halo_size"
            android:layout_height="@dimen/auth_icon_halo_size"
            android:layout_gravity="center_horizontal" />

        <TextView
            style="@style/Widget.AICoach.Auth.Title"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/auth_otp_title" />

        <TextView
            style="@style/Widget.AICoach.Auth.Subtitle"
            android:layout_gravity="center_horizontal"
            android:text="@string/auth_otp_desc" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="m••••••n@gmail.com" />

        <FrameLayout
            android:id="@+id/codeArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24">

            <EditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_otp_box_height"
                android:alpha="0"
                android:autofillHints="smsOTPCode"
                android:cursorVisible="false"
                android:importantForAutofill="yes"
                android:inputType="number"
                android:maxLength="6"
                android:textIsSelectable="false"
                tools:ignore="LabelFor" />

            <LinearLayout
                android:id="@+id/rowBoxes"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_otp_box_height"
                android:orientation="horizontal">

                <TextView android:id="@+id/box1" style="@style/Widget.AICoach.Auth.OtpBox" />
                <TextView android:id="@+id/box2" style="@style/Widget.AICoach.Auth.OtpBox" />
                <TextView android:id="@+id/box3" style="@style/Widget.AICoach.Auth.OtpBox" />
                <TextView android:id="@+id/box4" style="@style/Widget.AICoach.Auth.OtpBox" />
                <TextView android:id="@+id/box5" style="@style/Widget.AICoach.Auth.OtpBox" />
                <TextView
                    android:id="@+id/box6"
                    style="@style/Widget.AICoach.Auth.OtpBox"
                    android:layout_marginEnd="0dp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/auth_otp_wrong"
            android:textColor="@color/state_error"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/space_4"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Gửi lại mã sau 00:42" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/auth_otp_demo_hint"
            android:textAppearance="@style/TextAppearance.AICoach.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_20"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/auth_otp_confirm" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
