<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 22 Thông báo (mở từ chuông ở Trang chủ) — Thành viên B.
    B tự viết: SocialRepository.mock(MockSocialData.notifications()), lọc theo 3 nút trên,
    adapter rvNotifications (item_notification), "Đọc tất cả", trạng thái rỗng emptyState.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.AICoach.Auth.BackButton" />

        <TextView
            style="@style/Widget.AICoach.B.ToolbarTitle"
            android:text="@string/social_notifications_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReadAll"
            style="@style/Widget.AICoach.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/social_read_all"
            android:textColor="@color/brand_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_survey_segment"
        android:orientation="horizontal"
        android:padding="@dimen/space_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterAll"
            style="@style/Widget.AICoach.Segment"
            android:checked="true"
            android:text="@string/social_filter_all"
            tools:text="Tất cả (6)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterChallenges"
            style="@style/Widget.AICoach.Segment"
            android:text="@string/social_filter_challenges" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterSystem"
            style="@style/Widget.AICoach.Segment"
            android:text="@string/social_filter_system" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_24"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/item_notification" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bell_24"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/social_notifications_empty"
                android:textAppearance="@style/TextAppearance.AICoach.SectionTitle" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
