<?xml version="1.0" encoding="utf-8"?>
<!-- 1 hiệp trong bảng "Theo từng hiệp" (Figma 39). Số lỗi: 0 = xanh lá, 1–2 = cam, ≥ 3 = đỏ (B đặt màu trong adapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvSet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Hiệp 1" />

    <TextView
        android:id="@+id/tvReps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="15/15" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        app:indicatorColor="@color/brand_primary"
        app:trackColor="@color/brand_primary_light"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp"
        tools:progress="95" />

    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:minWidth="24dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="95" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8">

        <TextView
            android:id="@+id/tvErrors"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_progress_badge"
            android:backgroundTint="@color/state_success_light"
            android:gravity="center"
            android:textColor="@color/state_success"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="0" />
    </FrameLayout>
</LinearLayout>
