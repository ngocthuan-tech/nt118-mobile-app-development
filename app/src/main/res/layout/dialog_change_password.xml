<?xml version="1.0" encoding="utf-8"?>
<!--
    Đổi mật khẩu (BottomSheet, mở từ dòng "Đổi mật khẩu" ở Hồ sơ 43) — Thành viên B.
    ViewModel kiểm tra dữ liệu và gọi API; hộp thoại chỉ đóng khi thành công.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_24">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_password_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/session_password_change_hint"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        style="@style/Widget.AICoach.Auth.Label"
        android:text="@string/profile_password_current" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCurrent"
        style="@style/Widget.AICoach.Auth.TextInput"
        app:endIconMode="password_toggle"
        app:startIconDrawable="@drawable/ic_lock_24">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCurrent"
            style="@style/Widget.AICoach.Auth.EditText"
            android:autofillHints="password"
            android:hint="@string/profile_password_current"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Widget.AICoach.Auth.Label"
        android:text="@string/profile_password_new" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNew"
        style="@style/Widget.AICoach.Auth.TextInput"
        app:endIconMode="password_toggle"
        app:startIconDrawable="@drawable/ic_lock_24">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNew"
            style="@style/Widget.AICoach.Auth.EditText"
            android:autofillHints="newPassword"
            android:hint="@string/profile_password_new"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Widget.AICoach.Auth.Label"
        android:text="@string/profile_password_confirm" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilConfirm"
        style="@style/Widget.AICoach.Auth.TextInput"
        app:endIconMode="password_toggle"
        app:startIconDrawable="@drawable/ic_lock_24">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConfirm"
            style="@style/Widget.AICoach.Auth.EditText"
            android:autofillHints="newPassword"
            android:hint="@string/profile_password_confirm"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:textColor="@color/state_error"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_12"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        style="@style/Widget.AICoach.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_24"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/profile_password_submit" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
