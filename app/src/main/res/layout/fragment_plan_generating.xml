<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 16 AI đang tạo giáo án (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_48"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_16">

        <FrameLayout
            android:layout_width="@dimen/plan_generating_ring_size"
            android:layout_height="@dimen/plan_generating_ring_size">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                app:indicatorColor="@color/brand_sky"
                app:indicatorSize="@dimen/plan_generating_ring_size"
                app:trackColor="@color/white_10"
                app:trackCornerRadius="6dp"
                app:trackThickness="@dimen/plan_generating_ring_thickness"
                tools:progress="68" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/plan_generating_logo_size"
                    android:layout_height="@dimen/plan_generating_logo_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo_mark" />

                <TextView
                    android:id="@+id/tvPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="68%" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:gravity="center"
            android:text="@string/plan_generating_title"
            android:textAppearance="@style/TextAppearance.AICoach.OnDark.Title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <include
                android:id="@+id/stepBody"
                layout="@layout/view_generating_step" />

            <include
                android:id="@+id/stepGoal"
                layout="@layout/view_generating_step" />

            <include
                android:id="@+id/stepExercises"
                layout="@layout/view_generating_step" />

            <include
                android:id="@+id/stepSchedule"
                layout="@layout/view_generating_step" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.AICoach.Button.OnDark"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_16"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/common_retry"
            android:visibility="gone"
            app:icon="@drawable/ic_refresh_24" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plan_generating_footer"
            android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
