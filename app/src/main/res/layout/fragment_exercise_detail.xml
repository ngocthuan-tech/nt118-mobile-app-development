<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 25.1–25.9 Chi tiết bài tập — 1 layout dùng chung cho 9 bài (Thành viên A) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/exercise_bottom_bar_space">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ảnh người tập trên nền navy + khung camera -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/exercise_detail_header_height"
                android:background="@drawable/bg_screen_dark">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_24"
                    android:layout_marginTop="@dimen/space_48"
                    android:layout_marginEnd="@dimen/space_24"
                    android:layout_marginBottom="@dimen/space_48"
                    android:alpha="0.7"
                    android:background="@drawable/bg_camera_frame_cyan" />

                <ImageView
                    android:id="@+id/imgExercise"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/exercise_detail_image_height"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvCameraHint"
                    style="@style/Widget.AICoach.ChipDark"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/space_32"
                    android:drawableStart="@drawable/ic_camera_24"
                    android:drawableTint="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    tools:text="Camera: Nghiêng 45°, cách 2–3 m" />
            </FrameLayout>

            <!-- Thẻ nội dung trắng chồng lên ảnh -->
            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/exercise_detail_sheet_overlap_negative"
                android:background="@drawable/bg_exercise_sheet"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_20"
                android:paddingTop="@dimen/space_20"
                android:paddingEnd="@dimen/space_20">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Squat" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/rowTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:chipSpacingHorizontal="@dimen/space_8">

                    <TextView
                        android:id="@+id/tagGroup"
                        style="@style/Widget.AICoach.Exercise.Tag"
                        android:background="@drawable/bg_exercise_tag_outline"
                        android:textColor="@color/text_primary"
                        tools:text="Chân &amp; mông" />

                    <TextView
                        android:id="@+id/tagDifficulty"
                        style="@style/Widget.AICoach.Exercise.Tag"
                        android:background="@drawable/bg_chip_light"
                        android:backgroundTint="@color/state_success_light"
                        android:textColor="@color/state_success"
                        tools:text="Dễ" />

                    <TextView
                        android:id="@+id/tagAi"
                        style="@style/Widget.AICoach.Exercise.Tag"
                        android:background="@drawable/bg_chip_light"
                        android:backgroundTint="@color/brand_primary_light"
                        android:drawableStart="@drawable/ic_camera_24"
                        android:drawablePadding="@dimen/space_4"
                        android:drawableTint="@color/brand_primary"
                        android:textColor="@color/brand_primary"
                        tools:text="AI đếm số lần" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="2dp"
                    android:textAppearance="@style/TextAppearance.AICoach.Caption"
                    android:textSize="14sp"
                    tools:text="Bài tập nền tảng cho đùi và mông." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statTime"
                        layout="@layout/view_exercise_stat" />

                    <Space
                        android:layout_width="@dimen/space_8"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/statKcal"
                        layout="@layout/view_exercise_stat" />

                    <Space
                        android:layout_width="@dimen/space_8"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/statVolume"
                        layout="@layout/view_exercise_stat" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.AICoach.Survey.Section"
                    android:text="@string/exercise_how_to" />

                <LinearLayout
                    android:id="@+id/listSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="@dimen/space_12" />

                <TextView
                    style="@style/Widget.AICoach.Survey.Section"
                    android:text="@string/exercise_ai_tracks" />

                <LinearLayout
                    android:id="@+id/listAiChecks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Widget.AICoach.Survey.Section"
                    android:text="@string/exercise_tips" />

                <LinearLayout
                    android:id="@+id/listTips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Widget.AICoach.Survey.Section"
                    android:text="@string/exercise_mistakes" />

                <LinearLayout
                    android:id="@+id/listMistakes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nút trên ảnh: quay lại · "Bài 1/9" · chia sẻ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.AICoach.CircleIconButton"
            android:backgroundTint="@color/white_20"
            android:contentDescription="@string/exercise_back"
            android:src="@drawable/ic_chevron_left_24"
            app:tint="@color/white" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvPosition"
                style="@style/Widget.AICoach.ChipDark"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_card"
                android:visibility="gone"
                tools:text="Bài 1/9"
                tools:visibility="visible" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnShare"
            style="@style/Widget.AICoach.CircleIconButton"
            android:backgroundTint="@color/white_20"
            android:contentDescription="@string/exercise_share"
            android:src="@drawable/ic_share_24"
            app:tint="@color/white" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/brand_primary" />

    <!-- Lỗi tải -->
    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_32"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.AICoach.SectionTitle"
            tools:text="Không có kết nối mạng" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.AICoach.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:text="@string/common_retry" />
    </LinearLayout>

    <!-- Nút "Bắt đầu tập" cố định dưới đáy -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_exercise_bottom_fade"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/exercise_start"
            app:icon="@drawable/ic_play_24"
            app:iconSize="@dimen/icon_size_small" />
    </FrameLayout>
</FrameLayout>
