<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 10 Tạo mật khẩu mới (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_16">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.AICoach.Auth.BackButton" />

        <include
            android:id="@+id/icon"
            layout="@layout/view_auth_icon_halo"
            android:layout_width="@dimen/auth_icon_halo_size"
            android:layout_height="@dimen/auth_icon_halo_size"
            android:layout_gravity="center_horizontal" />

        <TextView
            style="@style/Widget.AICoach.Auth.Title"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/auth_new_password_title" />

        <TextView
            style="@style/Widget.AICoach.Auth.Subtitle"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="@string/auth_new_password_desc" />

        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:labelFor="@id/etPassword"
            android:text="@string/auth_new_password_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.AICoach.Auth.TextInput"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                style="@style/Widget.AICoach.Auth.EditText"
                android:autofillHints="newPassword"
                android:imeOptions="actionNext"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <include
            android:id="@+id/strength"
            layout="@layout/view_password_strength" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="vertical">

            <include
                android:id="@+id/ruleLength"
                layout="@layout/view_password_rule" />

            <include
                android:id="@+id/ruleCase"
                layout="@layout/view_password_rule" />

            <include
                android:id="@+id/ruleDigit"
                layout="@layout/view_password_rule" />

            <include
                android:id="@+id/ruleSpecial"
                layout="@layout/view_password_rule" />
        </LinearLayout>

        <TextView
            style="@style/Widget.AICoach.Auth.Label"
            android:labelFor="@id/etConfirm"
            android:text="@string/auth_new_password_confirm_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirm"
            style="@style/Widget.AICoach.Auth.TextInput"
            app:endIconMode="password_toggle"
            app:helperTextTextColor="@color/state_success"
            app:startIconDrawable="@drawable/ic_lock_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirm"
                style="@style/Widget.AICoach.Auth.EditText"
                android:autofillHints="newPassword"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_32" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/auth_new_password_submit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.AICoach.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_12"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/common_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
