<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 24 Tìm kiếm & bộ lọc — bottom sheet trên Thư viện (Thành viên A) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_20">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exercise_filter"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.AICoach.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_filter_reset"
                android:textColor="@color/brand_primary" />
        </LinearLayout>

        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/exercise_filter_muscle" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupMuscle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:chipSpacingHorizontal="@dimen/space_8" />

        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:text="@string/exercise_filter_difficulty" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:chipSpacingHorizontal="@dimen/space_8" />

        <TextView
            style="@style/Widget.AICoach.Survey.Section"
            android:text="@string/exercise_filter_ai_mode" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_survey_segment"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeAll"
                style="@style/Widget.AICoach.Segment"
                android:text="@string/exercise_filter_mode_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeReps"
                style="@style/Widget.AICoach.Segment"
                android:text="@string/exercise_filter_mode_reps" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeSeconds"
                style="@style/Widget.AICoach.Segment"
                android:text="@string/exercise_filter_mode_seconds" />
        </LinearLayout>

        <!-- Không cần dụng cụ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_auth_info_box"
            android:backgroundTint="@color/bg_screen"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <FrameLayout
                android:layout_width="@dimen/icon_circle_size"
                android:layout_height="@dimen/icon_circle_size"
                android:background="@drawable/bg_auth_gradient_square">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle_24"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exercise_filter_no_equipment"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exercise_filter_no_equipment_desc"
                    android:textAppearance="@style/TextAppearance.AICoach.Caption" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNoEquipment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/exercise_filter_no_equipment" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
