<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma 42 Mời bạn bè — Thành viên B.
    B tự viết: mã mời, sao chép / chia sẻ, tìm lọc tại chỗ, adapter rvFriends (item_friend_invite), đếm số đã chọn.
    "Gửi lời mời" → quay về 40 Thử thách đã nối sẵn.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/exercise_bottom_bar_space">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.AICoach.Auth.BackButton" />

                <TextView
                    style="@style/Widget.AICoach.B.ToolbarTitle"
                    android:text="@string/social_invite_title" />
            </LinearLayout>

            <!-- Thử thách đang mời -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_social_card_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <FrameLayout
                    android:layout_width="@dimen/icon_circle_size"
                    android:layout_height="@dimen/icon_circle_size"
                    android:background="@drawable/bg_icon_box"
                    android:backgroundTint="@color/white_20">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_trophy_24"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvChallengeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="100 Squat mỗi ngày" />

                    <TextView
                        android:id="@+id/tvChallengeMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption"
                        tools:text="7 ngày • Bắt đầu Thứ 2, 12/10" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mã mời -->
            <TextView
                style="@style/Widget.AICoach.Auth.Label"
                android:text="@string/social_invite_code" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_social_code_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_12">

                <TextView
                    android:id="@+id/tvCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:textColor="@color/brand_primary"
                    android:textSize="@dimen/b_code_size"
                    android:textStyle="bold"
                    tools:text="AIC-7Q2K" />

                <ImageButton
                    android:id="@+id/btnCopyCode"
                    style="@style/Widget.AICoach.CircleIconButton"
                    android:background="@drawable/bg_icon_box"
                    android:contentDescription="@string/social_copy_code"
                    android:src="@drawable/ic_copy_24"
                    app:tint="@color/brand_primary" />

                <ImageButton
                    android:id="@+id/btnQrCode"
                    style="@style/Widget.AICoach.CircleIconButton"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_icon_box"
                    android:contentDescription="@string/social_show_qr"
                    android:src="@drawable/ic_qr_code_24"
                    app:tint="@color/brand_primary" />
            </LinearLayout>

            <!-- Cách chia sẻ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyLink"
                    style="@style/Widget.AICoach.B.SmallOutline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:text="@string/social_copy_link"
                    app:icon="@drawable/ic_link_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMessage"
                    style="@style/Widget.AICoach.B.SmallOutline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:text="@string/social_message"
                    app:icon="@drawable/ic_send_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQr"
                    style="@style/Widget.AICoach.B.SmallOutline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/social_qr"
                    app:icon="@drawable/ic_qr_code_24" />
            </LinearLayout>

            <!-- Tìm bạn -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                style="@style/Widget.AICoach.Auth.TextInput"
                android:layout_marginTop="@dimen/space_16"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    style="@style/Widget.AICoach.Auth.EditText"
                    android:hint="@string/social_search_friends"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColorHint="@color/text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFriendsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/social_friends"
                    android:textAppearance="@style/TextAppearance.AICoach.SectionTitle"
                    tools:text="Bạn bè (5)" />

                <TextView
                    android:id="@+id/tvSelected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Đã chọn 3" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFriends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_friend_invite" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_exercise_bottom_fade"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/social_send_invites"
            app:icon="@drawable/ic_send_24"
            app:iconSize="@dimen/icon_size_small"
            tools:text="Gửi lời mời (3)" />
    </FrameLayout>
</FrameLayout>
