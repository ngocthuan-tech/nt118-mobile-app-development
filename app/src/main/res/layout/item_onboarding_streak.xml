<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 04: vòng lửa chuỗi ngày + 4 huy hiệu + thẻ bảng xếp hạng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_48"
        android:paddingEnd="@dimen/space_48">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/onboarding_frame_width">

            <FrameLayout
                android:layout_width="@dimen/onboarding_fire_size"
                android:layout_height="@dimen/onboarding_fire_size"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_onboarding_fire_circle"
                android:elevation="12dp">

                <ImageView
                    android:layout_width="@dimen/onboarding_fire_icon_size"
                    android:layout_height="@dimen/onboarding_fire_icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_fire_24"
                    app:tint="@color/white" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="@dimen/onboarding_badge_size"
                android:layout_height="@dimen/onboarding_badge_size"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_onboarding_badge"
                android:backgroundTint="@color/accent_cyan">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_medal_24"
                    app:tint="@color/accent_cyan" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="@dimen/onboarding_badge_size"
                android:layout_height="@dimen/onboarding_badge_size"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_onboarding_badge"
                android:backgroundTint="@color/state_warning">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_trophy_24"
                    app:tint="@color/state_warning" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="@dimen/onboarding_badge_size"
                android:layout_height="@dimen/onboarding_badge_size"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="@dimen/space_48"
                android:background="@drawable/bg_onboarding_badge"
                android:backgroundTint="@color/state_success">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_target_24"
                    app:tint="@color/state_success" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="@dimen/onboarding_badge_size"
                android:layout_height="@dimen/onboarding_badge_size"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="@dimen/space_48"
                android:background="@drawable/bg_onboarding_badge"
                android:backgroundTint="@color/brand_sky">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_badge_24"
                    app:tint="@color/brand_sky" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/onboarding_3_streak"
                    android:textColor="@color/white"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_3_streak_unit"
                    android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption" />
            </LinearLayout>
        </FrameLayout>

        <!-- Thẻ xếp hạng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <FrameLayout
                android:layout_width="@dimen/icon_circle_size"
                android:layout_height="@dimen/icon_circle_size"
                android:background="@drawable/bg_auth_gradient_circle">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_crown_24"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_3_rank"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_3_challenge"
                    android:textAppearance="@style/TextAppearance.AICoach.OnDark.Caption" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_3_points"
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/text"
        layout="@layout/item_onboarding_text" />
</LinearLayout>
