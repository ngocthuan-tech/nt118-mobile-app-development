<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 18 "Xin quyền camera" (Trưởng nhóm). Bấm "Cho phép" sẽ hiện hộp thoại hệ thống (Figma 19). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <!-- Hình minh hoạ: vòng sáng + điện thoại có khung xương + 2 huy hiệu -->
        <FrameLayout
            android:layout_width="@dimen/permission_illustration_size"
            android:layout_height="@dimen/permission_illustration_size">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/brand_primary_light" />

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="190dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dialog_dark"
                android:backgroundTint="@color/navy_900">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_body_24"
                    app:tint="@color/accent_cyan" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_fab_train">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera_24"
                    app:tint="@color/white" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start|bottom"
                android:layout_marginBottom="36dp"
                android:background="@drawable/bg_circle"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield_24"
                    app:tint="@color/state_success" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:text="@string/workout_permission_title"
            android:textAppearance="@style/TextAppearance.AICoach.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/workout_permission_desc"
            android:textAppearance="@style/TextAppearance.AICoach.Body"
            android:textColor="@color/text_secondary" />

        <!-- 3 cam kết quyền riêng tư -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="@dimen/space_12">

            <include
                android:id="@+id/rowOnDevice"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowNoStorage"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowControl"
                layout="@layout/view_info_row" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workout_permission_allow"
            app:icon="@drawable/ic_camera_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLater"
            style="@style/Widget.AICoach.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/workout_permission_later" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
