<?xml version="1.0" encoding="utf-8"?>
<!--
    Thành viên B — tab "Tiến độ": 37 Lịch sử, 38 Lịch tháng, 39 Chi tiết buổi tập.
    Thanh tab trỏ tới id của graph này (nav_social), không trỏ id màn: Navigation chỉ tìm được
    graph con trực tiếp của nav_root khi đang đứng ở graph khác (vd. đang ở Trang chủ).
    Thử thách (40–42) nằm ở nav_challenge.xml.
    Màn con khai báo hideBottomNav = true để MainActivity ẩn thanh tab.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_social"
    app:startDestination="@id/historyFragment">

    <!-- 37 Lịch sử & Thống kê (tab "Tiến độ") -->
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.aicoach.ui.history.HistoryFragment"
        android:label="@string/nav_progress"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_history_to_calendar"
            app:destination="@id/monthCalendarFragment" />
        <!-- B dùng khi bấm 1 dòng trong danh sách buổi tập -->
        <action
            android:id="@+id/action_history_to_session_detail"
            app:destination="@id/sessionDetailFragment" />
    </fragment>

    <!-- 38 Lịch tháng -->
    <fragment
        android:id="@+id/monthCalendarFragment"
        android:name="com.aicoach.ui.history.MonthCalendarFragment"
        android:label="@string/progress_calendar_title"
        tools:layout="@layout/fragment_month_calendar">
        <argument
            android:name="hideBottomNav"
            android:defaultValue="true"
            app:argType="boolean" />
        <action
            android:id="@+id/action_calendar_to_session_detail"
            app:destination="@id/sessionDetailFragment" />
    </fragment>

    <!-- 39 Chi tiết buổi tập -->
    <fragment
        android:id="@+id/sessionDetailFragment"
        android:name="com.aicoach.ui.history.SessionDetailFragment"
        android:label="@string/progress_detail_title"
        tools:layout="@layout/fragment_session_detail">
        <argument
            android:name="sessionId"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="exerciseId"
            android:defaultValue="squat"
            app:argType="string" />
        <argument
            android:name="hideBottomNav"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

</navigation>
