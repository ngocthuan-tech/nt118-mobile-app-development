<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Figma chỉ có giao diện sáng nên app cố định Light theme -->
    <style name="Base.Theme.AICoach" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary</item>
        <item name="colorSecondary">@color/navy_900</item>
        <item name="android:colorBackground">@color/bg_screen</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/state_error</item>
        <item name="materialButtonStyle">@style/Widget.AICoach.Button.Primary</item>
    </style>

    <style name="Theme.AICoach" parent="Base.Theme.AICoach" />

    <!-- Màn chờ khi mở app (Figma 01 Splash — nền navy) -->
    <style name="Theme.AICoach.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AICoach</item>
    </style>

    <!-- Kiểu chữ dùng chung — mọi TextView dùng android:textAppearance="@style/TextAppearance.AICoach.xxx" -->
    <style name="TextAppearance.AICoach.Display" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AICoach.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AICoach.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AICoach.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AICoach.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AICoach.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Chữ trên nền tối (màn camera) -->
    <style name="TextAppearance.AICoach.OnDark.Title" parent="TextAppearance.AICoach.Title">
        <item name="android:textColor">@color/text_on_dark</item>
    </style>

    <style name="TextAppearance.AICoach.OnDark.Caption" parent="TextAppearance.AICoach.Caption">
        <item name="android:textColor">@color/text_on_dark_secondary</item>
    </style>

</resources>
