<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ lựa chọn trong khảo sát (Figma 13 giới tính, 14 mục tiêu, 15 trình độ): chọn = viền xanh + nền xanh nhạt -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary_light" />
            <stroke
                android:width="1.5dp"
                android:color="@color/brand_primary" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</selector>
