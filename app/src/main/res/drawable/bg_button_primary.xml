<?xml version="1.0" encoding="utf-8"?>
<!-- Nút chính gradient xanh (Figma). Có hiệu ứng gợn khi bấm, mờ đi khi bị khoá. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/divider" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/white_40">
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="@color/brand_gradient_end"
                        android:startColor="@color/brand_gradient_start" />
                    <corners android:radius="@dimen/radius_pill" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
