<?xml version="1.0" encoding="utf-8"?>
<!-- Hôm nay (Figma 38): tròn gradient + viền cyan -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/accent_cyan" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/brand_gradient_end"
                android:startColor="@color/brand_gradient_start" />
        </shape>
    </item>
</layer-list>
