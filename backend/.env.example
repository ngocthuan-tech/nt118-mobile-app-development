# Copy thành file .env trên máy chủ:  cp .env.example .env  rồi sửa.
# File .env chứa bí mật — KHÔNG commit lên GitHub (đã có trong .gitignore).

# Tên miền của máy ảo Azure
API_DOMAIN=aicoach-r15.koreacentral.cloudapp.azure.com

# Mật khẩu database — tạo bằng: openssl rand -hex 16
DB_PASSWORD=doi-thanh-chuoi-ngau-nhien

# Khoá ký JWT, tối thiểu 32 ký tự — tạo bằng: openssl rand -base64 48
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu

# true = tạo tài khoản demo@aicoach.vn / Demo1234 có sẵn lịch sử tập
SEED_DEMO=true

# Gửi email mã quên mật khẩu (để trống = không gửi, mã ghi vào log: docker compose logs api | grep "Mã quên")
# Gmail riêng cho app: bật Xác minh 2 bước → tạo "Mật khẩu ứng dụng" 16 ký tự → dán vào MAIL_PASSWORD (bỏ dấu cách)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
